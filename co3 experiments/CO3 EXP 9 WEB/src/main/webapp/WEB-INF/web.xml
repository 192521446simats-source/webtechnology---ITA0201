<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>CO3 EXP 9 WEB - Servlet Lifecycle Demonstration</display-name>

    <servlet>
        <servlet-name>LifecycleServlet</servlet-name>
        <servlet-class>com.example.LifecycleServlet</servlet-class>
        <!-- load-on-startup left unset intentionally: the servlet is
             constructed + initialized lazily, on the FIRST request to
             /lifecycle, so students can observe the constructor and
             init() lines appear in the console at that exact moment. -->
    </servlet>

    <servlet-mapping>
        <servlet-name>LifecycleServlet</servlet-name>
        <url-pattern>/lifecycle</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

</web-app>
